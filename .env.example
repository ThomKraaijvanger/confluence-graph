# ── LLM (Mistral) ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-api-key-here
MISTRAL_MODEL=mistral-large-latest

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Pages ─────────────────────────────────────────────────────────────────────
# Directory containing your source pages (markdown files with YAML frontmatter).
# Defaults to ./pages relative to the project root if not set.
PAGES_DIR=/path/to/your/pages
