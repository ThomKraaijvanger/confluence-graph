# ── LLM ───────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works: Mistral, Azure OpenAI, a company proxy, etc.

LLM_API_KEY=your-api-key-here
LLM_MODEL=mistral-medium-latest

# Leave blank to use the default OpenAI endpoint.
# For Mistral: https://api.mistral.ai/v1
# For a self-hosted / company model: https://your-company-llm.example.com/v1
LLM_BASE_URL=https://api.mistral.ai/v1

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Pages ─────────────────────────────────────────────────────────────────────
# Directory that contains your source pages (markdown files).
# Defaults to ./pages relative to the project root if not set.
# For Confluence: point this to wherever you dump fetched Confluence pages.
PAGES_DIR=/path/to/your/pages
