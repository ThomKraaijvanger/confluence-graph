{
  "name": "confluence-graph",
  "version": "1.0.0",
  "description": "Neo4j semantic layer for Confluence, driven by an LLM",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "query": "tsx src/query.ts",
    "lint": "tsx src/lint.ts",
    "reset": "tsx src/reset.ts",
    "demo:reset": "tsx src/reset.ts && tsx src/ingest.ts",
    "demo:newpage": "PAGES_DIR=incoming tsx src/ingest.ts",
    "gen:corpus": "tsx src/gen-corpus.ts",
    "bench:reset": "tsx src/reset.ts && PAGES_DIR=corpus tsx src/ingest.ts",
    "benchmark": "tsx src/benchmark.ts"
  },
  "dependencies": {
    "@mistralai/mistralai": "^2.2.5",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "neo4j-driver": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
